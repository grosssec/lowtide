# Copy to .dev.vars for local Worker secrets. Never commit real values.
# Production values go in with `wrangler secret put <NAME>`.

# Token the Google Apps Script sends with bank alerts and hours
INGEST_TOKEN=

# Email alerts (Resend free tier)
RESEND_API_KEY=
ALERT_EMAIL=

# Web push notifications (VAPID key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
