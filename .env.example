# Worker secrets. Don't fill these in by hand: `node scripts/secrets.ts` writes them to .dev.vars (local),
# `node scripts/secrets.ts --remote` writes them to .env and stores them on Cloudflare. Never commit real values.

# What the Google Apps Script sends with bank alerts and hours (also goes into the script's properties)
INGEST_TOKEN=
# Signs the sign-in challenges, so asking for one writes nothing to the database
CHALLENGE_KEY=
# Web push key pair (VAPID): public key as base64url, private key as a JSON Web Key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=

# Local only (.dev.vars): skip passkey sign-in on localhost while developing. Never set it on Cloudflare.
# DEV_AUTH_BYPASS=1
