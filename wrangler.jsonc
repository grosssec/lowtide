/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-dashboard",
	"main": "worker/index.ts",
	// The app's address. Cloudflare issues and renews its certificate.
	"routes": [{ "pattern": "finance.ricardogross.com", "custom_domain": true }],
	// Only the custom domain: the old finance-dashboard.<subdomain>.workers.dev address is off.
	"workers_dev": false,
	"compatibility_date": "2026-09-26",
	"assets": {
		"not_found_handling": "single-page-application",
		// API routes always reach the Worker (and its auth check), never the SPA fallback.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finance",
			// Created with `wrangler d1 create finance --location enam` (2026-10-02). Local dev uses its own copy under .wrangler/.
			"database_id": "8aff7d70-8220-49a1-a6f0-6d74f1a830df",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"APP_NAME": "Lowtide",
		"TIMEZONE": "America/Chicago",
		"DEMO": "0",
		"DEMO_TODAY": ""
	},
	// Per-IP limits (per Cloudflare location): sign-in, the sync script, and everything else.
	"ratelimits": [
		{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "INGEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
		{ "name": "API_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
	],
	// Hourly: the Worker sends the daily push at 8 am local time (an hourly check follows daylight saving changes).
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Public demo with made-up data: read-only, a frozen "today", no cron, its own database.
	// Build and deploy with `npm run deploy:demo`.
	"env": {
		"demo": {
			"routes": [{ "pattern": "demo.ricardogross.com", "custom_domain": true }],
			"workers_dev": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "finance-demo",
					"database_id": "d05f1c9b-bf99-467e-a5ed-ce9f845bf3b2",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_NAME": "Lowtide demo",
				"TIMEZONE": "America/Chicago",
				"DEMO": "1",
				"DEMO_TODAY": "2026-10-08"
			},
			"ratelimits": [
				{ "name": "AUTH_LIMIT", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
				{ "name": "INGEST_LIMIT", "namespace_id": "1012", "simple": { "limit": 30, "period": 60 } },
				{ "name": "API_LIMIT", "namespace_id": "1013", "simple": { "limit": 300, "period": 60 } }
			],
			"triggers": { "crons": [] }
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}